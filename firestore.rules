rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.role in ['traveller', 'admin'];
    }

    function isValidSavedItinerary(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'corridor']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.corridor is string && data.corridor.size() <= 128;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['id', 'userId', 'providerId']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.providerId is string && data.providerId.size() <= 128;
    }

    function isValidCommunityNote(data) {
      return data.keys().hasAll(['id', 'userId', 'tipText']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.tipText is string && data.tipText.size() <= 2000;
    }

    // Initial connection diagnostic
    match /test/connection {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow delete: if isOwner(userId);

      // Subcollection: Saved Itineraries
      match /saved_itineraries/{itineraryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(itineraryId) && isValidSavedItinerary(incoming()) && incoming().userId == userId && incoming().id == itineraryId;
        allow update: if isOwner(userId) && isValidId(itineraryId) && isValidSavedItinerary(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(itineraryId);
      }

      // Subcollection: Bookmarked Providers
      match /bookmarks/{bookmarkId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId) && isValidBookmark(incoming()) && incoming().userId == userId && incoming().id == bookmarkId;
        allow update: if isOwner(userId) && isValidId(bookmarkId) && isValidBookmark(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }
    }

    // Community Notes (Public tips & feedback with author controls)
    match /community_notes/{noteId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(noteId) && isValidCommunityNote(incoming()) && incoming().userId == request.auth.uid && incoming().id == noteId;
      allow update: if isSignedIn() && isValidId(noteId) && isValidCommunityNote(incoming()) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(noteId) && existing().userId == request.auth.uid;
    }

    // Google Database: Destinations Collection
    match /destinations/{destId} {
      allow get, list: if true;
      allow write: if isSignedIn() || true; // allow initial seeding and admin management
    }

    // Google Database: Providers & Stays Collection
    match /providers/{providerId} {
      allow get, list: if true;
      allow write: if isSignedIn() || true; // allow initial seeding and registration
    }
  }
}
